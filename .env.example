# Copy this file to .env (same folder) and fill in your key.
# .env is ignored by git, so the key never gets uploaded.
#
# Used only when you press "Ask Claude" in the "What's happening" window.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which Claude model to ask (default: claude-opus-5-5)
# PULSEDECK_CLAUDE_MODEL=claude-opus-5-5

# Spending limits (defaults shown). Each press of "Ask Claude" sends at most
# one request: no automatic retries, a 60 s timeout, answers capped at 2000
# tokens, and at least 5 s between questions. When a daily limit is reached
# the button stops working until midnight.
# PULSEDECK_CLAUDE_DAILY_REQUESTS=20
# PULSEDECK_CLAUDE_DAILY_TOKENS=60000
