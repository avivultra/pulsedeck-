# Copy this file to .env (same folder) and fill in your key.
# .env is ignored by git, so the key never gets uploaded.
#
# Used only when you press "Ask Claude" in the "What's happening" window.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which Claude model to ask (default: claude-opus-5-5)
# PULSEDECK_CLAUDE_MODEL=claude-opus-5-5
